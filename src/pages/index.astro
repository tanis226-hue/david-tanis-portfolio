---
import Layout from '../layouts/Layout.astro';

// Personal site, not a second consulting site. ZLDA answers "why hire this firm".
// This answers "who is David, what has he done, how does his background fit
// together". Deliberately avoids the firm's vocabulary. Lead audience is employers
// and senior collaborators; clients get pointed to the firm.

// Right-column proof, kept to three lines so the column reads as intentional
// without becoming dense.
const scope = [
	'Cross-industry operational systems',
	'Discovery through rollout',
	'Regulated and compliance-sensitive workflows',
];

// Concise cards. The full context / role / approach / system / controls treatment
// belongs on per-project pages when those exist.
// `meta` is the client or domain, `status` the maturity. They render as separate
// lines so neither disappears into the other.
const work = [
	{
		name: 'Ordering and Fulfillment System',
		meta: "Marie's Caribbean Bakery",
		status: 'Live',
		body: 'Unified web, phone, and walk-in orders into one workflow with capacity rules, cutoff dates, and a central fulfillment queue.',
		href: 'https://mariescaribbeanbakery.com/',
		cta: 'Visit live site',
	},
	{
		name: 'Commerce and Product Operations',
		meta: 'The Usual Suspects Garage',
		status: 'In implementation',
		body: 'Built a phased platform for customer accounts, commerce, fulfillment, communication, and internal product-development tracking.',
		href: 'https://usgarage.netlify.app',
		cta: 'Visit live site',
	},
	{
		// No status and no link: private engagement, described by capability only.
		name: 'Healthcare Administrative Operations Platform',
		meta: 'Private client work',
		status: null,
		body: 'Designed a centralized system for credentialing, workforce operations, scheduling, and compliance-sensitive records.',
		href: null,
		cta: null,
	},
	{
		name: 'OpsAdvisor',
		meta: 'Applied AI',
		status: 'Prototype',
		body: 'Built a structured operations assessment tool that turns user-provided information into a prioritized improvement plan without allowing the model to invent findings.',
		href: 'https://opsadvisor.netlify.app/',
		cta: 'View prototype',
	},
];

// Not every job. The resume carries the full chronology.
const experience = [
	{
		org: 'ZLDA Group',
		role: 'Co-Founder, Business Systems',
		body: 'Design and implement operational systems for organizations managing work through spreadsheets, disconnected tools, and manual processes.',
	},
	{
		org: 'Florida SouthWestern State College',
		role: 'Adjunct Professor, Business and Technology',
		body: 'Teach undergraduate business and technology coursework beginning Fall 2026.',
	},
	{
		org: 'Physician organization',
		role: 'AI and Process Automation Lead',
		body: 'Led discovery and implementation of an internal administrative platform supporting more than 80 physicians.',
	},
	{
		org: 'Studio+',
		role: 'Project Administrator',
		body: 'Managed project financial operations across a six-office architecture practice and improved billing controls.',
	},
	{
		org: 'U.S. Navy Reserve',
		role: 'Construction Mechanic, Seabee',
		body: 'Maintained heavy-equipment readiness under Navy technical and documentation standards.',
	},
];

const base = 'https://www.zldagroup.com/insights';
const essays = [
	{ title: "Most Companies Aren't Ready for AI", href: `${base}/most-companies-arent-ready-for-ai` },
	{ title: 'Cost Discipline for AI: How to Think About ROI', href: `${base}/cost-discipline-for-ai` },
	{ title: 'Why Growing Businesses Start to Feel Inefficient', href: `${base}/why-growing-businesses-start-to-feel-inefficient` },
];

const nav = [
	{ href: '#work', label: 'Work' },
	{ href: '#experience', label: 'Experience' },
	{ href: '#writing', label: 'Writing' },
	{ href: '#about', label: 'About' },
	{ href: '#contact', label: 'Contact' },
];

const title = 'David Tanis - Business Systems Architect';
const description =
	'I work across operations, systems, and technology. Background in healthcare, legal services, architecture, education, and military service.';
---

<Layout title={title} description={description}>
	<header
		class="masthead sticky top-0 z-40 backdrop-blur-md"
		style="background-color: rgb(var(--color-bg-rgb) / 0.85)"
	>
		<div class="wrap-wide flex items-center justify-between py-3.5">
			<a href="#main" class="font-display text-lg font-bold tracking-tight">David Tanis</a>
			<nav aria-label="Sections" class="flex items-center gap-4 sm:gap-6">
				<ul class="hidden items-center gap-6 font-mono text-[0.75rem] lowercase tracking-wide text-ink-soft sm:flex">
					{nav.map((n) => (
						<li>
							<a href={n.href} class="transition hover:text-accent-dark">{n.label}</a>
						</li>
					))}
				</ul>
				<button
					id="theme-toggle"
					type="button"
					aria-label="Toggle dark mode"
					class="rounded-md px-3 py-1.5 text-meta font-semibold text-ink-muted transition hover:text-ink"
					style="border: 1px solid rgb(var(--color-border-rgb) / 0.14)"
				>
					Theme
				</button>
			</nav>
		</div>
	</header>

	<main id="main">
		<!-- Hero. wrap-wide and a 2.2fr text column so the headline sets in two lines. -->
		<section class="wrap-wide grid gap-10 pb-10 pt-10 sm:pt-14 lg:grid-cols-[2.2fr_1fr] lg:items-center lg:gap-14">
			<div class="lg:pt-2">
				<p class="kicker">Business Systems Architect / Naples, FL</p>
				<h1 class="mt-5 text-display">
					I work across operations, <span class="text-accent-dark">systems, and technology.</span>
				</h1>
				<p class="mt-6 max-w-[56ch] text-body-l text-ink-soft">
					My background spans healthcare, legal services, architecture, education, and military
					service. I focus on understanding how an organization works, improving how the work moves,
					and building practical systems where existing tools fall short.
				</p>
				<div class="mt-8 flex flex-wrap items-center gap-3">
					<a href="#work" class="btn-primary">View selected work</a>
					<a href="/David-Tanis-Resume.pdf" class="btn-ghost">View résumé</a>
				</div>
				<div class="mt-10 border-t border-line/12 pt-6">
					<p class="kicker text-ink-muted">Selected scope</p>
					<ul class="mt-4 grid gap-x-8 gap-y-3 sm:grid-cols-3">
						{scope.map((s) => (
							<li class="flex gap-2.5 text-meta text-ink-soft">
								<span aria-hidden="true" class="mt-1.5 h-1 w-1 flex-none rounded-full bg-accent"></span>
								<span>{s}</span>
							</li>
						))}
					</ul>
				</div>
			</div>
			<div class="lg:justify-self-end">
				<div class="max-w-[22rem]">
					<img
						src="/david-tanis-960.webp"
						srcset="/david-tanis-480.webp 480w, /david-tanis-960.webp 960w"
						sizes="(max-width: 640px) 200px, 340px"
						width="340"
						height="340"
						alt="David Tanis"
						fetchpriority="high"
						class="avatar h-[200px] w-[200px] sm:h-[340px] sm:w-[340px]"
					/>
					<p class="provenance mt-4">
						MBA in Information Systems / PMP / Lean Six Sigma Black Belt / CSCP
					</p>
					<p class="provenance mt-1.5">Adjunct Professor / U.S. Navy Reserve veteran</p>
				</div>
			</div>
		</section>

		<!-- Personal story, high on the page -->
		<section class="wrap-wide pb-14 sm:pb-16">
			<div class="border-t border-line/12 pt-8">
				<h2 class="max-w-[24ch] text-lead">I came to technology through operations.</h2>
				<div class="mt-5 grid gap-4 text-body-l text-ink-soft lg:max-w-[68ch]">
					<p>
						I started in environments where the work had to be accurate, documented, and completed
						under real constraints. Over time, I kept seeing the same problem: important operations
						were being managed through spreadsheets, disconnected tools, and knowledge held by a few
						people.
					</p>
					<p>
						I learned to design and build systems because I wanted to solve the whole problem, not
						stop at the recommendation.
					</p>
				</div>
			</div>
		</section>

		<!-- Selected work -->
		<section id="work" class="wrap-wide scroll-mt-20 pb-14 sm:pb-16">
			<div class="border-b border-line/15 pb-5">
				<p class="kicker">Selected work</p>
				<h2 class="mt-3 text-lead">A few systems I have built.</h2>
			</div>
			<ul class="grid gap-x-12 sm:grid-cols-2">
				{work.map((item) => (
					<li class="border-b border-line/10 py-7">
						<h3 class="text-title">{item.name}</h3>
						<p class="mt-2 text-body font-semibold text-ink-soft">{item.meta}</p>
						{item.status && (
							<p class="mt-2.5">
								<span
									class="inline-block rounded-full px-2.5 py-1 font-mono text-[0.65rem] uppercase tracking-[0.12em] text-accent-dark"
									style="background-color: rgb(var(--color-accent-rgb) / 0.1)"
								>{item.status}</span>
							</p>
						)}
						<p class="mt-4 max-w-[46ch] text-body text-ink-soft">{item.body}</p>
						{item.href && (
							<p class="mt-4">
								<a class="provenance link-accent" href={item.href} target="_blank" rel="noopener">
									{item.cta} &#8599;
								</a>
							</p>
						)}
					</li>
				))}
			</ul>
		</section>

		<!-- Experience -->
		<section id="experience" class="bg-bg-soft scroll-mt-20">
			<div class="wrap-wide py-14 sm:py-16">
				<div class="border-b border-line/15 pb-5">
					<p class="kicker">Experience</p>
					<h2 class="mt-3 text-lead">Different industries. A consistent pattern.</h2>
					<p class="mt-4 max-w-[64ch] text-body text-ink-soft">
						Across each role, the work has centered on understanding operations, improving controls,
						and building better systems.
					</p>
				</div>
				<ul class="mt-2">
					{experience.map((e) => (
						<li class="grid gap-1 border-b border-line/10 py-6 lg:grid-cols-[minmax(0,18rem)_minmax(0,1fr)] lg:gap-10">
							<div>
								<h3 class="text-body-l font-semibold text-ink">{e.org}</h3>
								<p class="provenance mt-1">{e.role}</p>
							</div>
							<p class="text-body text-ink-soft">{e.body}</p>
						</li>
					))}
				</ul>
				<p class="mt-6 text-meta text-ink-muted">
					Full chronology on the <a class="link-accent" href="/David-Tanis-Resume.pdf">résumé</a>.
				</p>
			</div>
		</section>

		<!-- Writing -->
		<section id="writing" class="wrap-wide scroll-mt-20 py-14 sm:py-16">
			<div class="flex flex-wrap items-baseline justify-between gap-4 border-b border-line/15 pb-5">
				<div>
					<p class="kicker">Writing</p>
					<h2 class="mt-3 text-lead">Writing on operations, systems, and applied AI.</h2>
				</div>
				<a class="provenance link-accent" href="https://www.zldagroup.com/insights">all essays &#8599;</a>
			</div>
			<ul>
				{essays.map((e) => (
					<li>
						<a href={e.href} class="index-row group block border-b border-line/10 py-5 lg:py-6">
							<span class="text-body-l text-ink transition-colors duration-200 group-hover:text-accent-dark">
								{e.title}
							</span>
						</a>
					</li>
				))}
			</ul>
		</section>

		<!-- About. Short: the fuller story is the section near the top. -->
		<section id="about" class="bg-bg-soft scroll-mt-20">
			<div class="wrap py-14 sm:py-16">
				<p class="kicker">About</p>
				<h2 class="mt-3 text-lead">Operator first. Builder by necessity.</h2>
				<p class="mt-6 max-w-[68ch] text-body-l text-ink-soft">
					I came to systems work through operations, where accuracy, documentation, and real-world
					constraints mattered. That background shaped how I approach technology today: understand
					the work first, then design the process, data, and systems around it.
				</p>
				<p class="mt-5 max-w-[68ch] text-body text-ink-soft">
					I hold an MBA in Information Systems and am completing an MS in Data Analytics and
					Artificial Intelligence. I am also a PMP, Lean Six Sigma Black Belt, CSCP, former Navy
					Reservist, and adjunct professor of Business and Technology.
				</p>
			</div>
		</section>

		<!-- Contact -->
		<section id="contact" class="wrap scroll-mt-20 py-14 sm:py-16">
			<p class="kicker">Contact</p>
			<h2 class="mt-3 text-lead">Let's connect.</h2>
			<p class="mt-5 max-w-[60ch] text-body-l text-ink-soft">
				I am interested in business systems, transformation, implementation, and AI-enablement roles,
				along with selected teaching and advisory opportunities.
			</p>
			<ul class="mt-7 flex flex-wrap gap-x-8 gap-y-2 text-body">
				<li><a class="link-accent" href="mailto:tanis226@gmail.com">Email</a></li>
				<li><a class="link-accent" href="https://www.linkedin.com/in/dtanis/">LinkedIn</a></li>
				<li><a class="link-accent" href="/David-Tanis-Resume.pdf">Résumé</a></li>
			</ul>
			<p class="mt-8 text-meta text-ink-muted">
				Looking for ZLDA Group? <a class="link-accent" href="https://zldagroup.com">Visit the firm's website.</a>
			</p>
		</section>
	</main>

	<footer class="wrap py-8">
		<div class="border-t border-line/12 pt-6 text-meta text-ink-muted">
			<p>David Tanis &middot; Naples, Florida</p>
		</div>
	</footer>
</Layout>
